msgstr "Продажи за день и импорт"

msgid "Clients, debtors and creditors"
msgstr "Клиенты, дебиторы и кредиторы"

msgid "Sales and production plan"
msgstr "План продаж и производства"

msgid "Daily production and calculation"
msgstr "Выпуск за день и калькуляция"

msgid "Raw materials: receipts, write-offs, counts"
msgstr "Сырьё: приход, списание, инвентаризация"

msgid "Finished goods and shipments"
msgstr "Готовая продукция и отгрузки"

msgid "Production import from Excel"
msgstr "Импорт производства из Excel"

msgid "Users, roles and permissions"
