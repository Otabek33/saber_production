msgstr "%(role)s: доступ изменён в разделах: %(count)s. У пользователей с этой ролью он уже действует."

msgid "Nothing changed."
msgstr "Ничего не изменилось."

msgid "%(counter)s section changed from the standard"
msgid_plural "%(counter)s sections changed from the standard"
