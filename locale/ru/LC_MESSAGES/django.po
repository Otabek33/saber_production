msgid "Standard access"
msgstr "Стандартный доступ"

msgid "Access"
msgstr "Доступ"

msgid "Standard"
msgstr "Стандарт"

msgid "Superuser only: not given to roles"
msgstr "Только суперпользователь: ролям не выдаётся"

msgid "Return this role to its standard access?"
msgstr "Вернуть этой роли стандартный доступ?"

