# Local development settings, loaded by config.settings.local (manage.py default).
# Copy to .env/local.env and adjust. Only the *.example files are committed;
# never commit real secrets. Real environment variables override this file.

DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database ---------------------------------------------------------------------
# PostgreSQL (install the driver first: uv sync --group postgres).
# Comment it out to fall back to SQLite at <project root>/db.sqlite3.
DATABASE_URL=postgres://finance_saber:password@localhost:5432/finance_saber

# Performance ------------------------------------------------------------------
# The debug toolbar slows every page down several times; turn on only to profile.
# DJANGO_DEBUG_TOOLBAR=True

# Telegram (password reset codes, daily report). Create the bot with @BotFather.
# Never put the real token here: this file is shared. It goes in .env/local.env only.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# TELEGRAM_BOT_USERNAME=your_bot_username
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string

# Time zone for "today" and the daily report's send time.
# DJANGO_TIME_ZONE=Asia/Tashkent
