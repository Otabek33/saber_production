# Production settings, loaded by config.settings.production (wsgi/asgi default).
# Copy to .env/production.env on the server and fill in every value. Only the
# *.example files are committed; never commit real secrets. Real environment
# variables (e.g. set by your hosting platform) override this file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_ADMIN_URL=some-hard-to-guess-path/

# Database ---------------------------------------------------------------------
DATABASE_URL=postgres://finance_saber:password@localhost:5432/finance_saber
# CONN_MAX_AGE=60

# Security ---------------------------------------------------------------------
# Raise to 31536000 (1 year) once HTTPS is confirmed working everywhere.
DJANGO_SECURE_HSTS_SECONDS=60

# Email ------------------------------------------------------------------------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=finance_saber <noreply@example.com>

# Telegram (password reset codes, daily report). Create the bot with @BotFather.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# TELEGRAM_BOT_USERNAME=your_bot_username
# TELEGRAM_WEBHOOK_SECRET=a-long-random-string
# The daily report needs a scheduler: run "manage.py send_daily_reports" every 5 minutes (cron / systemd timer).

# The daily report runs from deploy/systemd/finance_saber-daily-reports.timer.

# Time zone for "today" and the daily report's send time; public address for links in messages.
# DJANGO_TIME_ZONE=Asia/Tashkent
DJANGO_SITE_URL=https://example.com
